# No key is needed for local writing-signal analysis.
HOST=127.0.0.1
PORT=3210
# none | ollama | openai
AI_PROVIDER=none
# Ollama: install a multilingual model, e.g. ollama pull qwen3:8b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# Optional: auto-start a portable Ollama CLI when npm start runs.
# Existing running services are reused. These machine-specific paths stay in .env.
OLLAMA_EXECUTABLE=
OLLAMA_MODELS=
# OpenAI: set both values; use a model available in your account.
OPENAI_API_KEY=
OPENAI_MODEL=
# Required if binding to a non-loopback interface. Use a long random value.
APP_PASSWORD=
